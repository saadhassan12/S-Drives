APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=259200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAX_IMAGE_UPLOAD_KB=51200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Internal URL — Laravel/socket process → Node (often 127.0.0.1 on same VPS)
SOCKET_SERVER_URL=http://127.0.0.1:6001
# Public URL — mobile/browser Socket.IO io() MUST use this host only (no path). Optional; falls back to SOCKET_SERVER_URL.
SOCKET_SERVER_PUBLIC_URL=http://YOUR_PUBLIC_HOST:6001
SOCKET_INTERNAL_SECRET=change-me
SOCKET_PORT=6001
SOCKET_CORS_ORIGIN=*
# Laravel base URL for Node socket (server.js loads this via dotenv — same repo .env).
# Same VPS behind nginx/php-fpm: http://127.0.0.1 (omit :80). Use :8000 only with php artisan serve.
LARAVEL_API_URL=http://127.0.0.1
